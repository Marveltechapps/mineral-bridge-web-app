# MineralBridge /v2 REST base (includes /v2, no trailing slash). Backend default dev port is 5001.
# For the HttpOnly `mb_refresh` cookie (SameSite=Strict, Path=/v2/auth) the web app and API must be SAME-SITE
# (e.g. localhost:3000 -> localhost:5001, or app.example.com -> api.example.com). The API must list the web origin
# in CORS_WEB_ORIGINS / ALLOWED_ORIGINS. To serve the API same-origin instead, set this to /v2 and set
# API_PROXY_TARGET below.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/v2

# WebSocket ORIGIN (no path) for live auctions: the socket is ws(s)://<host>/v1/ws/auctions/:id.
# If omitted it is derived from NEXT_PUBLIC_API_BASE_URL (http -> ws, https -> wss).
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:5001

# Optional: sent as X-Client: mineralbridge-web/<version>.
NEXT_PUBLIC_CLIENT_VERSION=0.1.0

# Optional (server-side, not exposed to the browser): proxy /v2/* to this backend origin so the browser talks to its
# own origin (NEXT_PUBLIC_API_BASE_URL=/v2). WebSockets are NOT proxied by Next.js - keep NEXT_PUBLIC_WS_BASE_URL.
# API_PROXY_TARGET=http://localhost:5001

# Optional developer tools (simulated counterparties, screen jumps, reset). Honoured only outside production
# builds AND only while no live session exists. Never enable in a deployed environment.
# NEXT_PUBLIC_MB_DEV_TOOLS=1
